{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "google.maps"]
  },
  "include": [
    "src",
    "tests",
    "eslint.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.dist.config.ts"
  ]
}

