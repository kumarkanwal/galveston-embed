{
  "name": "galveston-embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts eslint.config.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:dist",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.4",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}

